  "cards": [
    {
      "dot": "cyan",
      "title": "Async Scan Lifecycle",
      "items": [
        "POST /api/scan verifies ownership + VERIFIED status, returns 202 {scan_id}",
        "Fire-and-forget in-process; status and per-source progress live only in MongoDB",
        "Findings persist incrementally; the 90s deadline yields PARTIAL, never a false clean result",
        "Fingerprints drive NEW / REAPPEARED / REMEDIATED across manual re-scans"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust Boundaries & Fetch Guard",
      "items": [
        "Unverified identifiers are never scanned; every route is scoped by the session user",
        "Fetch guard: SSRF checks, ≤10 pages/scan, 512KB/10s caps, login-walled denylist",
        "Blocked fetches downgrade to snippet-tier evidence; broker hits match brokers.json",
        "Raw text stays on-host (GLiNER at 127.0.0.1); Gemini gets a redacted schema only"
      ]
    },
    {
      "dot": "emerald",
      "title": "External Dependencies & Ops",
      "items": [
        "Serper.dev ≤6 queries/scan with HMAC-keyed TTL cache (6h); ExposedOrNot keyless",
        "Resend delivers 6-digit codes; dev mode prints them to the server console",
        "docker compose: app + sidecar + mongo (replSet rs0); GLiNER weights baked in",
        "Deterministic rules stamp rule_version; DELETE /api/account erases all data (DPDP)"
      ]
    }
  ]
